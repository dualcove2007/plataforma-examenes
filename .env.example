# Copia este archivo como .env y reemplaza los valores.
# NUNCA subas el .env a git (ya está en .gitignore).

# Genera una clave con:
#   python -c "import secrets; print(secrets.token_urlsafe(50))"
SECRET_KEY=cambia-esto-por-una-clave-larga-y-aleatoria
DEBUG=True

POSTGRES_DB=examenes
POSTGRES_USER=examenes
# El contenedor de Postgres no arranca sin contraseña.
POSTGRES_PASSWORD=cambia-esto

# Estos dos valores son para correr Django en tu PC (fuera de Docker).
# docker-compose publica la base en el puerto 5433 de tu equipo.
# Dentro de Docker, el compose los reemplaza solo (db:5432).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
REDIS_URL=redis://localhost:6379/0