+          ],
+        ),
+        const SizedBox(height: 16),
+
+        // Exámenes recientes
+        PanelCard(
+          child: Column(
+            crossAxisAlignment: CrossAxisAlignment.start,
+            children: [
+              const TituloBloque('Exámenes recientes', Icons.history_rounded),
+              const SizedBox(height: 12),
+              if (porExamen.isEmpty)
+                const Text(
