+
+  @override
+  Widget build(BuildContext context) => Scaffold(
+    body: Column(
+      children: [
+        CabeceraSeccion(
+          titulo: _enPestana ? 'Resultados' : 'Resultados del examen',
+          subtitulo: _enPestana
