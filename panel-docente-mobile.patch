+                      ),
+                    ),
+                    const Icon(
+                      Icons.chevron_right_rounded,
+                      color: Paleta.tintaSuave,
+                    ),
+                  ],
+                ),
+              );
+            },
+            vacio: const EstadoVacio(
+              titulo: 'Sin resultados',
+              mensaje:
+                  'Cuando tus estudiantes presenten los exámenes, aparecerán aquí.',
+            ),
+          ),
+        ),
+      ],
+    ),
